{
  "name": "ghoster",
  "version": "0.1.0",
  "description": "Anonymous browser. Tor built-in. No traces.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "npm run build:mac && npm run build:win && npm run build:linux",
    "build:mac": "electron-builder --mac dmg zip",
    "build:win": "electron-builder --win nsis portable",
    "build:linux": "electron-builder --linux AppImage deb tar.gz",
    "build:all": "electron-builder -mwl",
    "dist": "npm run build"
  },
  "author": {
    "name": "vvrmatos",
    "email": "ghoster@protonmail.com"
  },
  "license": "MIT",
  "build": {
    "appId": "com.ghoster.browser",
    "productName": "Ghoster",
    "artifactName": "Ghoster-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "darkModeSupport": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon-linux.png",
      "category": "Network;WebBrowser;Security",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] },
        { "target": "tar.gz", "arch": ["x64"] }
      ]
    },
    "dmg": {
      "title": "Ghoster",
      "iconSize": 128,
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "files": [
      "src/**/*",
      "!node_modules/.cache"
    ],
    "asar": true
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "socks-proxy-agent": "^8.0.5"
  }
}
